<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>HomeCore.PluginSdk</RootNamespace>
    <AssemblyName>HomeCore.PluginSdk</AssemblyName>
    <Version>0.2.0</Version>
    <Authors>homeCore Contributors</Authors>
    <Description>Plugin SDK for building HomeCore device plugins in .NET</Description>
    <PackageId>HomeCore.PluginSdk</PackageId>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The default glob would compile tests/ and examples/ into the library
         itself, because they live under the project directory. -->
    <Compile Remove="tests/**" />
    <Compile Remove="examples/**" />
    <None Remove="tests/**" />
    <None Remove="examples/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project asserts on internals that plugin authors should not
         see: the device tracker's path scoping, and the management dispatcher. -->
    <InternalsVisibleTo Include="HomeCore.PluginSdk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.*" />
  </ItemGroup>

</Project>
